{
  "specVersion": "0.1.0",
  "meta": { "layout": "auto", "accent": "#7c3aed" },
  "asks": [
    {
      "id": "text_single",
      "type": "ask_text",
      "prompt": "Single-line text",
      "help": "ask_text — auto half-width.",
      "spec": { "placeholder": "type here" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "text_multi",
      "type": "ask_text",
      "prompt": "Multiline text",
      "help": "ask_text multiline — auto full-width.",
      "required": false,
      "spec": { "multiline": true, "placeholder": "longer answer…" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "sel_list",
      "type": "ask_select",
      "prompt": "Select — list (default)",
      "spec": {
        "options": [
          { "id": "a", "label": "Alpha", "description": "first option" },
          { "id": "b", "label": "Bravo" }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "sel_segmented",
      "type": "ask_select",
      "prompt": "Select — segmented",
      "spec": {
        "display": "segmented",
        "options": [
          { "id": "lo", "label": "Low" },
          { "id": "md", "label": "Med" },
          { "id": "hi", "label": "High" }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "sel_cards",
      "type": "ask_select",
      "prompt": "Select — cards with icons",
      "help": "spec.display=cards + option.icon (curated SVG).",
      "spec": {
        "display": "cards",
        "options": [
          { "id": "ship", "label": "Ship", "description": "deploy now", "icon": "rocket" },
          { "id": "hold", "label": "Hold", "description": "needs review", "icon": "clock" },
          { "id": "block", "label": "Block", "description": "do not merge", "icon": "warning" },
          { "id": "star", "label": "Highlight", "description": "feature it", "icon": "star" }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "sel_grid_multi",
      "type": "ask_select",
      "prompt": "Multi-select — grid, with color swatches",
      "help": "multiple=true + display=grid + option.color.",
      "spec": {
        "multiple": true,
        "min": 1,
        "display": "grid",
        "options": [
          { "id": "red", "label": "Critical", "description": "P0", "color": "#dc2626" },
          { "id": "amber", "label": "Warning", "description": "P1", "color": "#d97706" },
          { "id": "green", "label": "Healthy", "description": "P2", "color": "#059669" },
          { "id": "blue", "label": "Info", "description": "P3", "color": "#1d4ed8" }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "confirm_cards",
      "type": "ask_confirm",
      "prompt": "Confirm — with consequence (renders as cards)",
      "spec": { "affirm": "Run migration", "deny": "Skip", "consequence": "Irreversible without a restore." },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "confirm_seg",
      "type": "ask_confirm",
      "prompt": "Confirm — no consequence (segmented)",
      "spec": { "affirm": "Yes", "deny": "No" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "num",
      "type": "ask_number",
      "prompt": "Number — bounded integer with unit",
      "spec": { "min": 1, "max": 64, "step": 1, "integer": true, "unit": "vCPU" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "rate_stars",
      "type": "ask_rating",
      "prompt": "Rating — stars with labels",
      "spec": { "max": 5, "icon": "star", "labels": { "min": "poor", "max": "great" } },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "rate_num",
      "type": "ask_rating",
      "prompt": "Rating — numeric, 1–10",
      "spec": { "max": 10, "icon": "number" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "slider",
      "type": "ask_slider",
      "prompt": "Slider — 0–100 step 5, live value",
      "spec": { "min": 0, "max": 100, "step": 5, "unit": "%" },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "date",
      "type": "ask_date",
      "prompt": "Date",
      "spec": {},
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "datetime",
      "type": "ask_date",
      "prompt": "Date + time",
      "spec": { "time": true },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "rank",
      "type": "ask_rank",
      "prompt": "Rank — reorderable, with descriptions",
      "help": "ask_rank — auto full-width.",
      "spec": {
        "items": [
          { "id": "speed", "label": "Ship speed" },
          { "id": "safety", "label": "Safety", "description": "rollback / blast radius" },
          { "id": "polish", "label": "UX polish" },
          { "id": "cost", "label": "Cost" }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "color_fixed",
      "type": "ask_color",
      "prompt": "Color — fixed palette only",
      "spec": { "palette": ["#1d4ed8", "#059669", "#d97706", "#dc2626", "#7c3aed", "#0891b2"] },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "color_custom",
      "type": "ask_color",
      "prompt": "Color — palette + custom picker",
      "spec": { "palette": ["#000000", "#ffffff", "#7c3aed"], "allowCustom": true },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "diff",
      "type": "ask_code_diff",
      "prompt": "Code diff — multi-file, per-hunk accept/reject",
      "help": "ask_code_diff — always full-width; the v0.1 wedge.",
      "spec": {
        "granularity": "hunk",
        "files": [
          {
            "path": "src/auth.ts",
            "hunks": [
              { "id": "h1", "header": "@@ tighten check @@", "before": "if (user) {\n  return allow();\n}", "after": "if (user && user.active) {\n  return allow();\n}" },
              { "id": "h2", "header": "@@ add audit log @@", "after": "logger.info('auth.granted', { uid: user.id });" }
            ]
          },
          {
            "path": "src/config.ts",
            "hunks": [
              { "id": "h3", "header": "@@ bump timeout @@", "before": "timeout: 3000", "after": "timeout: 10000" }
            ]
          }
        ]
      },
      "meta": { "specVersion": "0.1.0", "minTier": "tui" }
    },
    {
      "id": "forced_full",
      "type": "ask_number",
      "prompt": "Layout override — meta.span=\"full\" on a normally-half ask",
      "spec": { "min": 0, "max": 10 },
      "meta": { "specVersion": "0.1.0", "minTier": "tui", "span": "full" }
    }
  ]
}
